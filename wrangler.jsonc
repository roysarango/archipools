{
	"name": "archipools",
	"main": "src/worker.ts",
	"compatibility_date": "2026-09-01",
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist",
		"run_worker_first": ["/api/*"]
	},
	"routes": [
		{
			"pattern": "archi-pools.com",
			"custom_domain": true
		},
		{
			"pattern": "www.archi-pools.com",
			"custom_domain": true
		}
	]
}

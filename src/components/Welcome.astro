---
import "../styles/welcome.css";
---

<div class="page-shell">
  <header class="site-header">
    <a class="brand" href="#top" aria-label="Archipools Pool Services home">
      <img
        class="brand-logo"
        src="/logo1.jpg"
        alt="Archipools Pool Services"
        width="56"
        height="56"
      />
    </a>
    <nav aria-label="Primary navigation">
      <a href="#services">Services</a>
      <a href="#area">Service area</a>
      <a class="nav-cta" href="#contact">Get a quote</a>
    </nav>
  </header>

  <main id="top">
    <section class="hero">
      <div class="hero-copy">
        <p class="eyebrow"><span></span> Local pool care, done right</p>
        <h1>More pool time.<br /><em>Less pool work.</em></h1>
        <p class="hero-text">
          Dependable weekly maintenance for clean, balanced pools across North
          Dallas. Simple service, clear communication, and no surprises.
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href="#contact"
            >Request a free quote</a
          >
          <a class="text-link" href="#services">
            Explore our service
            <span aria-hidden="true">↓</span>
          </a>
        </div>
        <div class="trust-row" aria-label="Service benefits">
          <span><i aria-hidden="true">✓</i> Reliable weekly visits</span>
          <span><i aria-hidden="true">✓</i> Local Archipools team</span>
        </div>
      </div>

      <div
        class="pool-visual"
        aria-label="Stylized view of a clean swimming pool"
      >
        <div class="sun-glow"></div>
        <div class="pool-deck">
          <div class="chair">
            <span class="chair-back"></span>
            <span class="chair-seat"></span>
            <span class="chair-leg"></span>
          </div>
          <div class="plant">
            <span></span><span></span><span></span><i></i>
          </div>
        </div>
        <div class="pool-water">
          <div class="water-line line-one"></div>
          <div class="water-line line-two"></div>
          <div class="water-line line-three"></div>
          <div class="pool-step step-one"></div>
          <div class="pool-step step-two"></div>
          <div class="float">
            <span></span>
          </div>
        </div>
        <div class="offer-card">
          <span class="offer-label">New customer offer</span>
          <strong>50% off</strong>
          <p>your first month of weekly pool service</p>
          <small>Limited availability · Terms apply</small>
        </div>
      </div>
    </section>

    <section class="contact-section section" id="contact">
      <div class="contact-card">
        <div>
          <p class="eyebrow"><span></span> Ready for an easier pool season?</p>
          <h2>Let’s make your pool<br /><em>the easy part.</em></h2>
        </div>
        <div class="contact-action">
          <p>
            Tell us where you’re located and a little about your pool. We’ll
            follow up with a clear, no-pressure quote.
          </p>
          <a
            class="button button-primary"
            href="mailto:hello@example.com?subject=Pool service quote"
          >
            Request a free quote
          </a>
          <small>Preview contact address—replace before launch.</small>
        </div>
      </div>
    </section>
  </main>
</div>

---
import "../styles/welcome.css";
---

<section class="contact-section section" id="contact">
  <div class="contact-card">
    <div>
      <p class="eyebrow"><span></span> Ready for an easier pool season?</p>
      <h2>Let’s make your pool<br /><em>the easy part.</em></h2>
    </div>
    <div class="contact-action">
      <p>
        Tell us where you’re located and a little about your pool. We’ll follow
        up with a clear, no-pressure quote.
      </p>
      <a
        class="button button-primary"
        href="mailto:info@archi-pools.com?subject=Pool service quote"
      >
        Request a free quote
      </a>
      <small>Email us at info@archi-pools.com.</small>
    </div>
  </div>
</section>
